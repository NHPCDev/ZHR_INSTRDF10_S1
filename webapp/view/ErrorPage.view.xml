<mvc:View controllerName="com.nhpc.zhrinstrdf10s1.controller.ErrorPage"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m"
    >
    <App id="idErrorPage" >
        <Page id="idPageContactHR" title="{i18n>title}" showHeader="false">
            <content>
                <IllustratedMessage id="idIllustratedMsg" enableVerticalResponsiveness="true" illustrationType="sapIllus-SimpleNotFoundMagnifier"
                    title="{i18n>validationMsg}" class="hideExtraText"/>            
            </content>
        </Page>
    </App>
</mvc:View>