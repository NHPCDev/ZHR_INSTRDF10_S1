<mvc:View
    controllerName="com.nhpc.zhrinstrdf10s1.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    displayBlock="true"
    class="sapUiSizeCompact"
>
    <App id="idReportApp">
        <pages>
            <Page
                id="idReportPage"
                showHeader="false"
            >
                <content>
                    <uxap:ObjectPageLayout
                        id="idReportObjectPageLayout"
                        upperCaseAnchorBar="false"
                    >
                        <uxap:headerTitle>
                            <uxap:ObjectPageDynamicHeaderTitle>
                                <uxap:expandedHeading>
                                    <HBox
                                        fitContainer="true"
                                        alignItems="Center"
                                    >
                                        <Avatar
                                            src="sap-icon://activity-items"
                                            class="sapUiTinyMarginEnd"
                                            displayShape="Square"
                                        />
                                        <VBox class="sapUiTinyMarginBegin">
                                            <Title
                                                id="objPageHeader"
                                                text="{i18n>createDialogTitle}"
                                                wrapping="true"
                                            />
                                            <ObjectStatus
                                                title="{i18n>status}"
                                                text="{path:'viewModel>/formDetails/Status',formatter:'.formatter.formatTitleCase'}"
                                                class="sapMObjectStatusMedium statusBoldText"
                                                state="{path:'viewModel>/formDetails/Status',formatter:'.formatter.formatStatusState'}"
                                            />
                                        </VBox>
                                    </HBox>
                                </uxap:expandedHeading>
                                <uxap:snappedHeading>
                                    <HBox
                                        fitContainer="true"
                                        alignItems="Center"
                                    >
                                        <Avatar
                                            src="sap-icon://activity-items"
                                            class="sapUiTinyMarginEnd"
                                            displayShape="Square"
                                        />
                                        <VBox class="sapUiTinyMarginBegin">
                                            <Title
                                                id="objPageHeader1"
                                                text="{i18n>createDialogTitle}"
                                                wrapping="true"
                                            />
                                            <ObjectStatus
                                                title="{i18n>status}"
                                                text="{path:'viewModel>/formDetails/Status',formatter:'.formatter.formatTitleCase'}"
                                                class="sapMObjectStatusMedium statusBoldText"
                                                state="{path:'viewModel>/formDetails/Status',formatter:'.formatter.formatStatusState'}"
                                            />
                                        </VBox>
                                    </HBox>
                                </uxap:snappedHeading>
                                <uxap:actions>
                                    <Button
                                        text="{i18n>previewBtnText}"
                                        type="Emphasized"
                                        press="handlePreviewBtnPress"
                                        icon="sap-icon://show"
                                        visible="{= ${viewModel>/formDetails/Status} === 'Approved' || ${viewModel>/formDetails/Status} === 'Confirmed'}"
                                    />
                                </uxap:actions>
                            </uxap:ObjectPageDynamicHeaderTitle>
                        </uxap:headerTitle>
                        <uxap:headerContent>
                            <FlexBox
                                fitContainer="true"
                                wrap="Wrap"
                            >
                                <core:Fragment
                                    fragmentName="com.nhpc.zhrinstrdf10s1.fragment.EmployeeDetails"
                                    type="XML"
                                />
                            </FlexBox>
                        </uxap:headerContent>
                        <uxap:sections>
                            <uxap:ObjectPageSection
                                title="{i18n>transactionHoldingsBond}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection>
                                        <uxap:blocks>
                                            <VBox>
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zhrinstrdf10s1.fragment.TransactionHoldingsBond"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                            <uxap:ObjectPageSection
                                title="{i18n>transactionHoldingsEquity}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection>
                                        <uxap:blocks>
                                            <VBox>
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zhrinstrdf10s1.fragment.TransactionHoldingsEquity"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                            <uxap:ObjectPageSection
                                title="{i18n>otherDisclosures}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection>
                                        <uxap:blocks>
                                            <VBox>
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zhrinstrdf10s1.fragment.OtherDisclosures"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                            <uxap:ObjectPageSection
                                title="{i18n>transactionRelativesBond}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection>
                                        <uxap:blocks>
                                            <VBox>
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zhrinstrdf10s1.fragment.TransactionRelativesBond"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                            <uxap:ObjectPageSection
                                title="{i18n>transactionRelativesEquity}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection>
                                        <uxap:blocks>
                                            <VBox>
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zhrinstrdf10s1.fragment.TransactionRelativesEquity"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                            <uxap:ObjectPageSection
                                title="{i18n>historyRemarks}"
                                titleUppercase="false"
                                visible="{= ${viewModel>/formDetails/Status} === 'Confirmed' || ${viewModel>/formDetails/Status} === 'Returned'}"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection>
                                        <uxap:blocks>
                                            <VBox>
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zhrinstrdf10s1.fragment.HistoryRemarks"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                        </uxap:sections>
                    </uxap:ObjectPageLayout>
                </content>
                <footer>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <Button
                            text="{i18n>saveBtnText}"
                            type="Critical"
                            press="handleSaveBtnPress"
                            icon="sap-icon://save"
                            visible="{= ${viewModel>/formDetails/Status} !== 'Confirmed'}"
                        />
                        <Button
                            text="{i18n>submitBtnText}"
                            type="Success"
                            press="handleSubmitBtnPress"
                            icon="sap-icon://create"
                            visible="{= ${viewModel>/formDetails/Status} !== 'Confirmed'}"
                        />
                    </OverflowToolbar>
                </footer>
            </Page>
        </pages>
    </App>
</mvc:View>
