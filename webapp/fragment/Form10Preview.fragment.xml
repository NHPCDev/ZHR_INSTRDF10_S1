<c:FragmentDefinition xmlns:form="sap.ui.layout.form"
    xmlns="sap.m"
    xmlns:c="sap.ui.core"
    class="sapUiSizeCompact">
    <Dialog title="{i18n>form10Preview}" horizontalScrolling="false" >
    <content>
    <VBox  class="sapUiSmallMargin">
    <Title text="{i18n>form10}" class="blueTitle"></Title>
    <Title text="{i18n>preforma}" textAlign="Center" class="sapUiSmallMargin blueTitle" ></Title>
    <FormattedText
    htmlText="{
        parts: [
            { path: 'viewModel>/formDetails/EmployeeName' },
            { path: 'viewModel>/selectedYear' },
            { path: 'viewModel>/nextYear' }
        ],
        formatter: '.formatter.formatName'
    }" class="sapUiSmallMargin"/>
    <form:SimpleForm class="sapUiSmallMargin" >
        <Label text="{i18n>employeeIdLabel}"></Label>
        <Text text="{path: 'viewModel>/formDetails/EmployeeId', formatter: '.formatter.formatBlankValue'}"></Text>
        <Label text="{i18n>employeeNameLabel}"></Label>
        <Text text="{path: 'viewModel>/formDetails/EmployeeName', formatter: '.formatter.formatBlankValue'}"></Text>
        <Label text="{i18n>designationLabel}"></Label>
        <Text text="{path: 'viewModel>/formDetails/PositionText', formatter: '.formatter.formatBlankValue'}"></Text>
        <Label text="{i18n>departmentLabel}"></Label>
        <Text text="{path: 'viewModel>/formDetails/EmployeeDepartment', formatter: '.formatter.formatBlankValue'}"></Text>
        <Label text="{i18n>dateOfJoiningLabel}"></Label>
        <Text text="{path: 'viewModel>/formDetails/DateOfJoining', formatter: '.formatter.formatDate'}"></Text>
    </form:SimpleForm>
            <Title
                text="{i18n>table1header}" class="sapUiSmallMarginTop"
            />
    <Table
            items="{viewModel>/TransactionHolding}"
            mode="None"
            updateFinished="onTransactionHoldingTableUpdateFinish"
            class="sapUiSmallMargin"
        >
            <columns>
                <Column>
                    <Text text="{i18n>Noofsecuritiesprev}" />
                </Column>
                <Column>
                    <Text text="{i18n>securityPurchased}" />
                </Column>
                <Column>
                    <Text text="{i18n>Noofsecuritiesheld}" />
                </Column>
                <Column>
                    <Text text="{i18n>Dpclientid}" />
                </Column>
                <Column>
                    <Text text="{i18n>Transactiondate}" />
                </Column>
                <Column>
                    <Text text="{i18n>Securitypurchased}" />
                </Column>
                <Column >
                    <Text text="{i18n>Securitysold}"></Text>
                </Column>
                <Column >
                    <Text text="{i18n>Offmarket}"></Text>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{viewModel>Noofsecuritiesprev}" />
                        <Text text="{viewModel>securityPurchased}" />
                        <Text text="{viewModel>Noofsecuritiesheld}" />
                        <Text text="{viewModel>Dpclientid}" />
                        <Text text="{path:'viewModel>Transactiondate',formatter:'.formatter.formatDate'}" />
                        <Text text="{viewModel>Securitypurchased}" />
                        <Text text="{viewModel>Securitysold}" />
                        <Text text="{viewModel>Offmarket}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
            <Title
                text="{i18n>table2header}"
            />
        <Table
            id="idOtherDisclosuresTable1"
            items="{viewModel>/OtherDisclosures}"
            mode="None"
            updateFinished="onTransactionHoldingTableUpdateFinish"
        >
            <columns>
                <Column>
                    <Text text="{i18n>panno}" />
                </Column>
                <Column>
                    <Text text="{i18n>mobileNo}" />
                </Column>
                <Column>
                    <Text text="{i18n>emailID}" />
                </Column>
                <Column>
                    <Text text="{i18n>nameOfImmediateRelative}" />
                </Column>
                <Column>
                    <Text text="{i18n>relationOfImmediateRelative}" />
                </Column>
                <Column>
                    <Text text="{i18n>phoneNoofImmediateRelative}" />
                </Column>
                <Column >
                    <Text text="{i18n>panOfImmediateRelative}"></Text>
                </Column>
                <Column>
                    <Text text="{i18n>nameOfPersonWhomDesignatedSharesMaternalRelation}" />
                </Column>
                <Column >
                    <Text text="{i18n>mobileOfPersonWhomDesignatedSharesMaternalRelation}"></Text>
                </Column>
                <Column >
                    <Text text="{i18n>panOfPersonWhomDesignatedSharesMaternalRelation}"></Text>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{viewModel>PanNoSelf}" />
                        <Text text="{viewModel>MobileNo}" />
                        <Text text="{viewModel>EmailIdSelf}" />
                        <Text text="{viewModel>NameOfImmediateRelatives}" />
                        <Text text="{viewModel>RelationOfImmediateRelative}" />
                        <Text text="{viewModel>PhoneNoOfImmediateRelative}" />
                        <Text text="{viewModel>PanOfImmediateRelative}" />
                        <Text text="{viewModel>NameOfFinancialGuide}"></Text>
                        <Text text="{viewModel>PhoneNoOfFinancialGuide}"></Text>
                        <Text text="{viewModel>PanOfOfFinancialGuide}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
            <Title
                text="{i18n>table2data}" class="sapUiSmallMarginTop"
            />
        <Table
            id="idTransactionRelativeTable1"
            items="{viewModel>/TransactionRelatives}"
            mode="None"
            updateFinished="onTransactionRelativeTableUpdateFinish"
            class="sapUiSmallMargin"
        >
            <columns>
                <Column>
                    <Text text="{i18n>Relativename}" />
                </Column>
                <Column>
                    <Text text="{i18n>Noofsecuritiesprev}" />
                </Column>
                <Column>
                    <Text text="{i18n>securityPurchased}" />
                </Column>
                <Column>
                    <Text text="{i18n>Noofsecuritiesheld}" />
                </Column>
                <Column>
                    <Text text="{i18n>Dpclientid}" />
                </Column>
                <Column>
                    <Text text="{i18n>Relativetype}" />
                </Column>
                <Column>
                    <Text text="{i18n>Transactiondate}" />
                </Column>
                <Column>
                    <Text text="{i18n>Securitypurchased}" />
                </Column>
                <Column >
                    <Text text="{i18n>Securitysold}"></Text>
                </Column>
                <Column>
                    <Text text="{i18n>SecuritypurchasedConsideration}" />
                </Column>
                <Column >
                    <Text text="{i18n>SecuritysoldConsideration}"></Text>
                </Column>
                <Column >
                    <Text text="{i18n>Offmarket}"></Text>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{viewModel>Relativename}"/>
                        <Text text="{viewModel>Noofsecuritiesprev}" />
                        <Text text="{viewModel>securityPurchased}" />
                        <Text text="{viewModel>Noofsecuritiesheld}" />
                        <Text text="{viewModel>Dpclientid}" />
                        <Text text="{viewModel>Relativetype}" />
                        <Text text="{path:'viewModel>Transactiondate',formatter:'.formatter.formatDate'}" />
                        <Text text="{viewModel>Securitypurchased}" />
                        <Text text="{viewModel>Securitysold}" />
                        <Text text="{viewModel>Securitypurchasedconso}"></Text>
                        <Text text="{viewModel>Securitysoldconso}"></Text>
                        <Text text="{viewModel>Offmarket}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <FormattedText
        htmlText="{path:'viewModel>/formDetails/UndertakingText',
        formatter:'.formatter.formatterUndertakingText'}"
        class="sapUiSmallMargin"/>
        </VBox>
        </content>
        <endButton>
        <Button
            text="{i18n>cancelBtnText}"
            press="onForm10PreviewCancel"/>
    </endButton>
        </Dialog>
</c:FragmentDefinition>