<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    class="sapUiSizeCompact"
>
    <VBox class="sapUiSmallMargin">
        <Table
            items="{viewModel>/undertakingDocs}"
            showSeparators="None"
            backgroundDesign="Transparent"
        >
            <columns>
                <Column width="auto">
                    <Text text="{i18n>undertaking}" />
                </Column>
                <Column
                    width="4rem"
                    hAlign="End"
                >
                    <Text text="{i18n>agree}" />
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text
                            text="{viewModel>text}"
                            wrapping="true"
                        />
                        <CheckBox
                            selected="{viewModel>selected}"
                            editable="{= ${viewModel>/formDetails/Status} !== '03' &amp;&amp; ${viewModel>/formDetails/Status} !== '02'}"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
</core:FragmentDefinition>
<!-- End of Change: 06.11.2026: Balamurugan : Declaration Added, Create button added at table level and total value label change -->