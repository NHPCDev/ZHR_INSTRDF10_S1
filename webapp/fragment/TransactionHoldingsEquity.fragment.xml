<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:table="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    class="sapUiSizeCompact"
>
    <VBox>
        <Toolbar>
            <Title
                text="{= ${i18n>transactionHoldings} + ' (' + ${viewModel>/TransactionHoldingEquityLength} + ')' }"
            />
        </Toolbar>
        <table:Table
            id="idTransactionHoldingEquityTable"
            rows="{viewModel>/TransactionHoldingEquity}"
            selectionMode="None"
            alternateRowColors="true"
            width="100%"
            rowsUpdated="onTransactionHoldingEquityTableUpdateFinish"
        >
            <table:rowMode>
                <rowmodes:Fixed
                    rowCount="{= ${viewModel>/TransactionHoldingEquityLength} >= 2 ? 2 : 1}"
                    rowContentHeight="45"
                />
            </table:rowMode>
            <table:columns>
                <table:Column width="180px">
                    <Text text="{i18n>natureOfSecurity}" />
                    <table:template>
                        <Text text="{viewModel>NatureOfSecurity}" />
                    </table:template>
                </table:Column>
                <table:Column width="180px">
                    <Text text="{i18n>Noofsecuritiesprev}" />
                    <table:template>
                        <Text text="{viewModel>Noofsecuritiesprev}" />
                    </table:template>
                </table:Column>
                <table:Column width="180px">
                    <Text text="{i18n>TransactionType}" />
                    <table:template>
                        <Text text="{viewModel>TransactionType}" />
                    </table:template>
                </table:Column>
                <table:Column width="180px">
                    <Text text="{i18n>Noofsecuritiesheld}" />
                    <table:template>
                        <Text text="{viewModel>Noofsecuritiesheld}" />
                    </table:template>
                </table:Column>
                <table:Column width="160px">
                    <Text text="{i18n>createdOn}" />
                    <table:template>
                        <Text
                            text="{path:'viewModel>Createdon',formatter:'.formatter.formatDate'}"
                        />
                    </table:template>
                </table:Column>
                <table:Column width="160px">
                    <Text text="{i18n>Dpclientid}" />
                    <table:template>
                        <Text text="{viewModel>Dpclientid}" />
                    </table:template>
                </table:Column>
                <table:Column width="160px">
                    <Text text="{i18n>Transactiondate}" />
                    <table:template>
                        <Text
                            text="{path:'viewModel>Transactiondate',formatter:'.formatter.formatDate'}"
                        />
                    </table:template>
                </table:Column>
                <table:Column width="180px">
                    <Text text="{i18n>Securitypurchased}" />
                    <table:template>
                        <Text text="{viewModel>Securitypurchased}" />
                    </table:template>
                </table:Column>
                <table:Column width="180px">
                    <Text text="{i18n>Securitysold}" />
                    <table:template>
                        <Text text="{viewModel>Securitysold}" />
                    </table:template>
                </table:Column>
                <table:Column width="220px">
                    <Text text="{i18n>SecuritypurchasedConsideration}" />
                    <table:template>
                        <Text text="{viewModel>Securitypurchasedconso}" />
                    </table:template>
                </table:Column>
                <table:Column width="220px">
                    <Text text="{i18n>SecuritysoldConsideration}" />
                    <table:template>
                        <Text text="{viewModel>Securitysoldconso}" />
                    </table:template>
                </table:Column>
                <table:Column width="150px">
                    <Text text="{i18n>Offmarket}" />
                    <table:template>
                        <Text text="{viewModel>Offmarket}" />
                    </table:template>
                </table:Column>
            </table:columns>
        </table:Table>
    </VBox>
</core:FragmentDefinition>
