<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    class="sapUiSizeCompact"
>
    <VBox>
        <Toolbar>
            <Title
                text="{= ${i18n>otherDisclosures} + ' (' + ${viewModel>/OtherDisclosuresLength} + ')' }"
            />
            <ToolbarSpacer />
            <Button
                text="{i18n>createOtherDisclosures}"
                icon="sap-icon://add"
                type="Accept"
                press="onNavToForm11"
                visible="{= ${viewModel>/formDetails/Status} === 'New' || ${viewModel>/formDetails/Status} === 'Draft' || ${viewModel>/formDetails/Status} === 'Returned'}"
            />
        </Toolbar>
        <Table
            id="idOtherDisclosuresTable"
            items="{viewModel>/OtherDisclosures}"
            mode="None"
            updateFinished="onTransactionHoldingTableUpdateFinish"
        >
            <columns>
                <!-- <Column>
                    <Text text="{i18n>panno}" />
                </Column>
                <Column>
                    <Text text="{i18n>mobileNo}" />
                </Column>
                <Column>
                    <Text text="{i18n>emailID}" />
                </Column> -->
                <Column>
                    <Text text="{i18n>nameOfImmediateRelative}" />
                </Column>
                <Column>
                    <Text text="{i18n>relationOfImmediateRelative}" />
                </Column>
                <Column>
                    <Text text="{i18n>phoneNoofImmediateRelative}" />
                </Column>
                <Column>
                    <Text text="{i18n>panOfImmediateRelative}" />
                </Column>
                <Column>
                    <Text
                        text="{i18n>nameOfPersonWhomDesignatedSharesMaternalRelation}"
                    />
                </Column>
                <Column>
                    <Text
                        text="{i18n>mobileOfPersonWhomDesignatedSharesMaternalRelation}"
                    />
                </Column>
                <Column>
                    <Text
                        text="{i18n>panOfPersonWhomDesignatedSharesMaternalRelation}"
                    />
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <!-- <Text text="{viewModel>PanNoSelf}" />
                        <Text text="{viewModel>MobileNo}" />
                        <Text text="{viewModel>EmailIdSelf}" /> -->
                        <Text text="{viewModel>NameOfImmediateRelatives}" />
                        <Text text="{viewModel>RelationOfImmediateRelative}" />
                        <Text text="{viewModel>PhoneNoOfImmediateRelative}" />
                        <Text text="{viewModel>PanOfImmediateRelative}" />
                        <Text text="{viewModel>NameOfFinancialGuide}" />
                        <Text text="{viewModel>PhoneNoOfFinancialGuide}" />
                        <Text text="{viewModel>PanOfOfFinancialGuide}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
</core:FragmentDefinition>
