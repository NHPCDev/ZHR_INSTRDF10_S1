<c:FragmentDefinition xmlns="sap.m"
    xmlns:c="sap.ui.core"
    class="sapUiSizeCompact">
    <HBox class="sapUiSmallMarginBegin" justifyContent="SpaceBetween" renderType="Bare" wrap="Wrap"   >
        <VBox renderType="Bare" wrap="Wrap" >
            <ObjectStatus title="{i18n>employeeIdLabel}" text="{path: 'viewModel>/formDetails/EmployeeId', formatter: '.formatter.formatBlankValue'}" />
            <ObjectStatus title="{i18n>employeeNameLabel}" text="{path: 'viewModel>/formDetails/EmployeeName', formatter: '.formatter.formatBlankValue'}" />       
        </VBox>
        <VBox class="sapUiLargeMarginBegin" renderType="Bare" wrap="Wrap" >
            <ObjectStatus title="{i18n>userID}" text="{path: 'viewModel>/formDetails/USRID', formatter: '.formatter.formatBlankValue'}" />
            <ObjectStatus title="{i18n>mobile}" text="{path: 'viewModel>/formDetails/MOBILE', formatter: '.formatter.formatBlankValue'}" />
        </VBox>
        <VBox class="sapUiLargeMarginBegin" renderType="Bare" wrap="Wrap" >
            <ObjectStatus title="{i18n>email}" text="{path: 'viewModel>/formDetails/EMAIL', formatter: '.formatter.formatBlankValue'} " />
            <ObjectStatus title="{i18n>dateOfJoining}" text="{path: 'viewModel>/formDetails/DATE_JOIN', formatter: '.formatter.formatBlankValue'}" />
        </VBox>
    </HBox>
</c:FragmentDefinition>