<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    class="sapUiSizeCompact"
>
    <VBox>
        <Toolbar>
            <Title
                text="{= ${i18n>transactionRelatives} + ' (' + ${viewModel>/TransactionRelativesBondLength} + ')' }"
            />
            <ToolbarSpacer />
            <Button
                text="{i18n>addBtnText}"
                icon="sap-icon://add"
                type="Accept"
                press="onNavToForm9"
                visible="{= ${viewModel>/formDetails/Status} === 'New' || ${viewModel>/formDetails/Status} === 'Draft' || ${viewModel>/formDetails/Status} === 'Returned'}"
            />
        </Toolbar>
        <Table
            id="idTransactionRelativeBondTable"
            items="{viewModel>/TransactionRelativesBond}"
            mode="{= ${viewModel>/formDetails/Status} !== 'Approved' &amp;&amp; ${viewModel>/formDetails/Status} !== 'Confirmed' ? 'SingleSelectLeft' : 'None'}"
            updateFinished="onTransactionRelativeBondTableUpdateFinish"
        >
            <columns>
                <Column>
                    <Text text="{i18n>natureOfSecurity}" />
                </Column>
                <Column>
                    <Text text="{i18n>Relativename}" />
                </Column>
                <Column>
                    <Text text="{i18n>Relativetype}" />
                </Column>
                <Column>
                    <Text text="{i18n>Others}" />
                </Column>
                <Column>
                    <Text text="{i18n>Noofsecuritiesprev}" />
                </Column>
                <Column>
                    <Text text="{i18n>securityPurchased}" />
                </Column>
                <Column>
                    <Text text="{i18n>Noofsecuritiesheld}" />
                </Column>
                <Column>
                    <Text text="{i18n>createdOn}" />
                </Column>
                <Column>
                    <Text text="{i18n>Dpclientid}" />
                </Column>
                <Column>
                    <Text text="{i18n>Transactiondate}" />
                </Column>
                <Column>
                    <Text text="{i18n>Securitypurchased}" />
                </Column>
                <Column >
                    <Text text="{i18n>Securitysold}"></Text>
                </Column>
                <Column>
                    <Text text="{i18n>SecuritypurchasedConsideration}" />
                </Column>
                <Column >
                    <Text text="{i18n>SecuritysoldConsideration}"></Text>
                </Column>
                <Column >
                    <Text text="{i18n>Offmarket}"></Text>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{viewModel>NatureOfSecurity}" />
                        <Text text="{viewModel>Relativename}"/>
                        <Text text="{viewModel>Relativetype}" />
                        <Text text="{viewModel>Others}" />
                        <Text text="{viewModel>Noofsecuritiesprev}" />
                        <Text text="{viewModel>TransactionType}" />
                        <Text text="{viewModel>Noofsecuritiesheld}" />
                        <Text text="{path:'viewModel>Createdon',formatter:'.formatter.formatDate'}"></Text>
                        <Text text="{viewModel>Dpclientid}" />                        
                        <Text text="{path:'viewModel>Transactiondate',formatter:'.formatter.formatDate'}" />
                        <Text text="{viewModel>Securitypurchased}" />
                        <Text text="{viewModel>Securitysold}" />
                        <Text text="{viewModel>Securitypurchasedconso}"></Text>
                        <Text text="{viewModel>Securitysoldconso}"></Text>
                        <Text text="{viewModel>Offmarket}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
</core:FragmentDefinition>
